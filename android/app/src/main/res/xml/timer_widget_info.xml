<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1: clock or "Not tracking" and one button. Taller adds the app name
     and recent projects. See TimerWidgetProvider. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_timer"
    android:previewLayout="@layout/widget_timer_preview"
    android:description="@string/timer_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
